    "knowledge": "node scripts/build-knowledge.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/storage": "^8.4.0",
    "@langchain/core": "^1.3.0",
    "@langchain/groq": "^1.3.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0"
  }
}
