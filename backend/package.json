{
  "name": "cholan-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch-path=src src/server.js",
    "start": "node src/server.js",
