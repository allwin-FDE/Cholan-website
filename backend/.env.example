# Copy to .env.local and fill in. Nothing here is required to run locally:
# with no GCP settings the backend stores enquiries in SQLite alone.

PORT=8080

# Local SQLite file. Defaults to ../.data/enquiries.db (outside backend/, so
# the dev watcher does not restart on the database's own writes).
DB_FILE=../.data/enquiries.db

# Browsers allowed to submit the form, comma separated.
ALLOWED_ORIGINS=http://localhost:5173

# --- GCP / Firestore ---
# Leave GCLOUD_PROJECT empty to keep enquiries local only.
GCLOUD_PROJECT=
FIRESTORE_COLLECTION=enquiries

# How often the outbox is pushed to Firestore, in ms. 0 disables the worker.
SYNC_INTERVAL_MS=60000
SYNC_BATCH_SIZE=25
SYNC_MAX_ATTEMPTS=5

# --- Reading stored enquiries ---
# Required to call GET /api/enquiries from anywhere but localhost.
ADMIN_TOKEN=

# --- Abuse limits ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# --- Website assistant (POST /api/chat, LangChain on Groq) ---
# Groq API key (console.groq.com). The chat stays off until this is set.
GROQ_API_KEY=
# Optional overrides.
CHAT_MODEL=openai/gpt-oss-120b
CHAT_GUARD_MODEL=openai/gpt-oss-20b
CHAT_EFFORT=low
CHAT_MAX_TOKENS=4000
# Questions allowed per visitor per window.
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=15

# --- Dashboard (/dashboard on the website) ---
# Put in front of the dashboard's Firestore collections (visits, activity,
# posts, dashboardAccess). Use dev_ locally so testing never touches live data.
FIRESTORE_PREFIX=
# Always have full access; others are added in the dashboard's Settings.
OWNER_EMAILS=admin@chennairiceindustries.com,ashleyjosco@chennairiceindustries.com
# Private bucket for blog images, served through GET /api/media/*.
MEDIA_BUCKET=cholan-rice-site-media
# Visitor activity is deleted after this many days (Firestore TTL on expireAt).
TRACK_RETENTION_DAYS=400

# --- Sales Daddy (CRM) ---
# Every enquiry also becomes a lead in Sales Daddy. Make the key in Sales Daddy:
# Settings → Integrations → Developer API, for the workspace the leads go to.
# Leave empty to skip. Enquiries stored while it is empty are never sent.
SALESDADDY_API_KEY=
# Source key the leads are filed under (from the workspace's sources).
SALESDADDY_SOURCE=website
