# Copy to .env.local and fill in. Nothing here is required to run locally:
# with no GCP settings the backend stores enquiries in SQLite alone.

PORT=8080

# Local SQLite file. Defaults to ../.data/enquiries.db (outside backend/, so
# the dev watcher does not restart on the database's own writes).
DB_FILE=../.data/enquiries.db

# Browsers allowed to submit the form, comma separated.
ALLOWED_ORIGINS=http://localhost:5173

# --- GCP / Firestore ---
# Leave GCLOUD_PROJECT empty to keep enquiries local only.
GCLOUD_PROJECT=
FIRESTORE_COLLECTION=enquiries

# How often the outbox is pushed to Firestore, in ms. 0 disables the worker.
SYNC_INTERVAL_MS=60000
SYNC_BATCH_SIZE=25
SYNC_MAX_ATTEMPTS=5

# --- Reading stored enquiries ---
# Required to call GET /api/enquiries from anywhere but localhost.
ADMIN_TOKEN=

# --- Abuse limits ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# --- Website assistant (POST /api/chat, LangChain on Groq) ---
# Groq API key (console.groq.com). The chat stays off until this is set.
GROQ_API_KEY=
# Optional overrides.
CHAT_MODEL=openai/gpt-oss-120b
CHAT_GUARD_MODEL=openai/gpt-oss-20b
CHAT_EFFORT=low
CHAT_MAX_TOKENS=4000
# Questions allowed per visitor per window.
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=15

# --- Dashboard (/dashboard on the website) ---
# Put in front of the dashboard's Firestore collections (visits, activity,
# posts, dashboardAccess). Use dev_ locally so testing never touches live data.
FIRESTORE_PREFIX=
# Always have full access; others are added in the dashboard's Settings.
OWNER_EMAILS=admin@chennairiceindustries.com,ashleyjosco@chennairiceindustries.com
# Private bucket for blog images, served through GET /api/media/*.
MEDIA_BUCKET=cholan-rice-site-media
# Visitor activity is deleted after this many days (Firestore TTL on expireAt).
TRACK_RETENTION_DAYS=400

# --- Sales Daddy (CRM) ---
# Every enquiry also becomes a lead in Sales Daddy. Make the key in Sales Daddy:
# Settings → Integrations → Developer API, for the workspace the leads go to.
# Leave empty to skip. Enquiries stored while it is empty are never sent.
SALESDADDY_API_KEY=
# Source key the leads are filed under (from the workspace's sources).
SALESDADDY_SOURCE=website
# Tag on leads from the store finder (name + mobile before a search). Create the
# tag in Sales Daddy first; empty = no tag.
SALESDADDY_FINDER_TAG=

# --- Razorpay (online payments) ---
# Test Mode keys while building (rzp_test_…), Live keys (rzp_live_…) at launch.
# Locally in .env.local; on Cloud Run the secret and webhook secret go in
# Secret Manager, never in this file or the repo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Business database (PostgreSQL, Cloud SQL instance cholan-db) ---
# Locally: the test server in D:\cholan-dev-db (port 5433). Values live in .env.local.
DEV_DB_ADMIN_URL=
MIGRATE_DATABASE_URL=
DATABASE_URL=
# On Cloud Run (no passwords: Google identity through the Cloud SQL connector):
#   INSTANCE_CONNECTION_NAME=cholan-rice-site:asia-south1:cholan-db
#   DB_IAM_USER=cholan-api@cholan-rice-site.iam        (the website)
#   DB_IAM_USER=cholan-migrator@cholan-rice-site.iam   (the release job)
#   DB_NAME=cholan  DB_POOL_MAX=3

# --- Store finder (/stores, Google Maps) ---
# Server key restricted to the Geocoding, Places (New) and Routes APIs. On
# Cloud Run it comes from Secret Manager (google-maps-server-key). The browser
# key for showing the map is separate: VITE_GOOGLE_MAPS_BROWSER_KEY at the
# website's build, restricted to cholanrice.in and the Maps JavaScript API.
GOOGLE_MAPS_SERVER_KEY=
# Stores compared by road distance per search (the rest by straight line).
MAPS_SHORTLIST=10
# Daily caps (India's date) on paid calls from customers' searches; past them
# the finder shows straight-line distances, clearly labelled.
# Keep these under Google's own daily quotas on the project (set 2026-11-21:
# road distances 380 elements = 38 searches, address lookups 320, map views
# 320, listing searches 160), which hold Maps under Rs 1,000 a month.
MAPS_ROUTE_DAILY_LIMIT=38
MAPS_GEOCODE_DAILY_LIMIT=250
# A search needs a name and mobile number, one search per number; this caps
# the new numbers one device (IP) can use in a day.
MAPS_NUMBERS_PER_DEVICE=5
# Google's own daily quotas, as set in the Cloud console, for the usage bar in
# /admin > Stores (defaults 320, 160, 160, 380, 320). Change them together.
# MAPS_QUOTA_GEOCODE=320
# MAPS_QUOTA_PLACES=160
# MAPS_QUOTA_PLACE=160
# MAPS_QUOTA_ROUTE_ELEMENTS=380
# MAPS_QUOTA_MAP_LOADS=320
# 1 = answer Google calls locally with made-up places (tests only, never live).
MAPS_FAKE=
# Tag for leads from the website's "Order on WhatsApp" button (must exist in Sales Daddy).
SALESDADDY_WA_ORDER_TAG=Whatsapp order
